# Copy to .env for local development. On Vercel, set these under
# Project → Settings → Environment Variables (the Neon integration adds the
# DATABASE_URL ones for you).

# Postgres. Leave unset to run the site on bundled sample data.
DATABASE_URL="postgresql://user:password@localhost:5432/roost"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/roost"

# Password for /admin. Admin is disabled when this is unset.
ADMIN_PASSWORD="change-me"
